# Keep these out of the image.
# The image only needs go.mod, go.sum, cmd/ and internal/;
# everything else only makes the build context bigger.
*.key
received/
*.md
.git/
.github/
docs/
test/

# Compiled binaries and test output (see .gitignore — never committed,
# but present locally)
/server
/client
/puresend
/bin/
dist/
coverage.out
